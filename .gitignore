# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
backend/dietetyk.db
backend/dietetyk.db-journal

# Dependency directories
node_modules/
jspm_packages/

# Optional npm cache directory
.npm

# Output directories
frontend/dist/
backend/public/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Credential files must never be committed. The entries below are a backstop,
# not a place to put secrets: a git-ignored plaintext file still ends up in
# directory backups, rsync copies and editor workspace indexes. Server
# credentials belong in a password manager; integration secrets belong in the
# Settings tab, where they are encrypted at rest (backend/utils/encryption.js).
passwords.txt
passwords*.txt
credentials.txt
secrets.txt
*.pem
*.key

# OS files
.DS_Store
Thumbs.db

# Runtime database & SSL certs directory
data/

# Pliki tymczasowe / backupy z refaktoryzacji (nie wdrażać)
backend/server.js.monolith.bak
backend/**/*.tmp

# Tymczasowe, ręcznie rozpakowane przykładowe eksporty (np. Health Auto Export)
# wgrywane lokalnie do analizy formatu danych - nigdy nie commitować (dane zdrowotne).
HealthAutoExport_*/

# Track package-lock.json regardless of global gitignore settings
!package-lock.json

# SQLite temporary files and backups
backend/dietetyk.db-shm
backend/dietetyk.db-wal
backend/backups/

# Playwright test artifacts
test-results/
playwright-report/
