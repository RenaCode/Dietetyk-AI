PORT=3000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Key material for encrypting secrets at rest in the database (utils/encryption.js) - NOT a
# login password. Must be a long, random, per-deployment value: `openssl rand -hex 32`.
# This file used to carry a concrete value here; anyone with a copy of the .db file could then
# re-derive the encryption key straight from the repository. Changing this value on an existing
# deployment requires re-encrypting the database first - see backend/docs/secret-rotation.md.
APP_PASSWORD=your_long_random_app_password_here
OURA_CLIENT_ID=your_oura_client_id_here
OURA_CLIENT_SECRET=your_oura_client_secret_here

# Adres publiczny apki (np. https://dietetyk.example.com) - używany do budowania
# redirect_uri w przepływach OAuth (Oura/Withings/Google) oraz jako dozwolone
# źródło CORS. Bez tego część integracji może nie działać poprawnie na produkcji.
APP_URL=

# Secret for signing (HMAC) the `state` parameter of the OAuth flow - CSRF protection for
# Oura/Withings/Google linking (services/oauthHelpers.js).
# REQUIRED: the backend refuses to start without it. It used to fall back to APP_PASSWORD, which
# meant one value both decrypted the database and signed OAuth state - and a forged state on the
# google_link service attaches an attacker's Google account to someone else's user row.
# Must be its own random value, different from APP_PASSWORD: `openssl rand -hex 32`.
OAUTH_STATE_SECRET=your_random_oauth_state_secret_here

# Withings OAuth - opcjonalne, używane głównie przez skrypty testowe
# (test-withings.js); w normalnym działaniu klucze są skonfigurowane per-użytkownik
# w panelu Ustawień, nie globalnie.
WITHINGS_CLIENT_ID=your_withings_client_id_here
WITHINGS_CLIENT_SECRET=your_withings_client_secret_here
WITHINGS_REDIRECT_URI=

# Hasło początkowego konta admina tworzonego przy pierwszym starcie backendu.
# Jeśli nie ustawione, backend wygeneruje losowe hasło i wypisze je raz w logach.
ADMIN_INITIAL_PASSWORD=

# Katalog, w którym backend trzyma plik bazy SQLite. Jeśli nie ustawione, używany
# jest katalog backendu (__dirname) - przydatne do wskazania trwałego wolumenu
# w Dockerze.
DATABASE_DIR=
